<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <TieredPGO>true</TieredPGO>
    <RestoreSources></RestoreSources>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Tedd.DotNetLab.Harness"><HintPath>@HARNESS@</HintPath></Reference>
    <Reference Include="Tedd.DotNetLab.Contracts"><HintPath>@CONTRACTS@</HintPath></Reference>
    <Reference Include="Tedd.DotNetLab.Transport.Local"><HintPath>@TRANSPORT@</HintPath></Reference>
  </ItemGroup>
</Project>
