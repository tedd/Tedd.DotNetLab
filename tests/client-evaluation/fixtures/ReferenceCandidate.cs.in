using System.Globalization;
public static class Candidate
{
    public static long SumSquares(int[] values)
    { long sum = 0; foreach (int value in values) sum = unchecked(sum + (long)value * value); return sum; }
    public static long Csv(string text)
    {
        long sum = 0;
        var remaining = text.AsSpan();
        while (!remaining.IsEmpty)
        {
            int split = remaining.IndexOf(',');
            var part = split < 0 ? remaining : remaining[..split];
            sum = unchecked(sum + long.Parse(part, CultureInfo.InvariantCulture));
            if (split < 0) break;
            remaining = remaining[(split + 1)..];
        }
        return sum;
    }
    public static int Membership(string[] queries, string[] allowed)
    { var set = new HashSet<string>(allowed, StringComparer.Ordinal); int count = 0; foreach (string query in queries) if (set.Contains(query)) count++; return count; }
    public static int CountByte(byte[] bytes, byte needle)
    { int count = 0; foreach (byte value in bytes) if (value == needle) count++; return count; }
    public static string Join(string[] fields) => string.Join("|", fields);
    public static int[] Deduplicate(int[] values)
    { var seen = new HashSet<int>(); var result = new List<int>(); foreach (int value in values) if (seen.Add(value)) result.Add(value); return result.ToArray(); }
    public static long[] Prefix(int[] values)
    { var result = new long[values.Length]; long sum = 0; for (int i = 0; i < values.Length; i++) result[i] = sum += values[i]; return result; }
    public static ValueTask<long> CachedSum(int[] cached, CancellationToken cancellation)
    { cancellation.ThrowIfCancellationRequested(); long sum = 0; foreach (int value in cached) { cancellation.ThrowIfCancellationRequested(); sum += value; } return ValueTask.FromResult(sum); }
}
