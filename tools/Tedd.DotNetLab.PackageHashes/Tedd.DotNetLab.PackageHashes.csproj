<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <!-- Build-only use of the selected SDK's own reader; no new NuGet dependency. -->
    <Reference Include="NuGet.Packaging" HintPath="$(MSBuildBinPath)/NuGet.Packaging.dll" />
    <Reference Include="NuGet.Common" HintPath="$(MSBuildBinPath)/NuGet.Common.dll" />
    <Reference Include="NuGet.Versioning" HintPath="$(MSBuildBinPath)/NuGet.Versioning.dll" />
    <Reference Include="NuGet.Frameworks" HintPath="$(MSBuildBinPath)/NuGet.Frameworks.dll" />
    <Reference Include="NuGet.Configuration" HintPath="$(MSBuildBinPath)/NuGet.Configuration.dll" />
    <Reference Include="System.Security.Cryptography.Pkcs" HintPath="$(MSBuildBinPath)/System.Security.Cryptography.Pkcs.dll" />
    <Reference Include="System.Security.Cryptography.ProtectedData" HintPath="$(MSBuildBinPath)/System.Security.Cryptography.ProtectedData.dll" />
  </ItemGroup>
  <Target Name="RequireCompatibleSdk" BeforeTargets="BeforeBuild">
    <Error Condition="!$([MSBuild]::VersionGreaterThanOrEquals('$([System.String]::Copy(&quot;$(NETCoreSdkVersion)&quot;).Split(&quot;-&quot;)[0])', '10.0.100'))" Text="Package hashing requires .NET SDK 10.0.100 or later." />
  </Target>
</Project>
